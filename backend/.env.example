# Variaveis de ambiente — Backend (Render)
# Configure TODAS no painel do Render (Environment). Nunca comite valores reais.

# Banco (Neon PostgreSQL) — connection string completa
DATABASE_URL=jdbc:postgresql://seu-host.neon.tech:5432/seu_db?sslmode=require&user=seu_user&password=sua_senha
DATABASE_USERNAME=seu_user
DATABASE_PASSWORD=sua_senha

# Seguranca
JWT_SECRET=gere-um-segredo-longo-aleatorio-de-pelo-menos-32-caracteres
JWT_EXPIRATION_MS=86400000

# CORS (origem do frontend na Vercel)
CORS_ALLOWED_ORIGINS=https://gendaz-leads.vercel.app

# Limites de geracao
MIN_LEADS_PER_REQUEST=3
MAX_LEADS_PER_REQUEST=30
DISCOVERY_MULTIPLIER=3

# Descoberta de leads: somente OSM (Nominatim + Overpass). Sem Google Places.
# OpenStreetMap / Overpass (nao requer chave)
OSM_ENABLED=true
OSM_TIMEOUT_MS=10000
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Groq (analise e geracao de mensagens)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENABLED=true
GROQ_TIMEOUT_MS=30000
GROQ_MAX_RETRIES=2

# Fila de envio (provider real deve ser implementado no futuro)
MESSAGING_PROVIDER=log
SEND_INTERVAL_SECONDS=30
MAX_CONCURRENT_SENDS=1

# WhatsApp (whatsapp-service Node/Baileys, sessao unica)
WHATSAPP_SERVICE_URL=
WHATSAPP_INTERNAL_TOKEN=
WHATSAPP_SESSION_ID=gendaz-leads
WHATSAPP_TIMEOUT_MS=15000

# Rate limit (por IP)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# App
APP_ENV=prod
PORT=8080
